{
  "name": "nba-draft-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node ./node_modules/typescript/bin/tsc && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "shard:data": "node ../script/frontend/build_static_data_manifest.mjs",
    "validate:data": "node ../script/frontend/validate_frontend_data.mjs",
    "test:cap-tracker": "node ../script/frontend/test_cap_tracker_data.mjs",
    "test:offseason-market": "node ../script/frontend/run_offseason_market_regression.mjs",
    "test:offseason-view-models": "node ../script/frontend/run_offseason_view_model_regression.mjs",
    "test:offseason-console": "node ../script/frontend/run_offseason_console_smoke.mjs",
    "test:cap-sandbox": "node ../script/frontend/run_cap_sandbox_regression.mjs",
    "test:trade-scenarios": "node ../script/frontend/run_trade_scenarios_regression.mjs",
    "test:trade-suggestions": "node ../script/frontend/run_trade_suggestions_regression.mjs",
    "test:trade-machine": "node ../script/frontend/run_trade_machine_regression.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
